        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.sessions = store.sessions || {};\n\nconst sid = $json.sessionId;\nconst found = ($json.chatInput || '').toUpperCase().match(/\\bC\\d+\\b/);\n\nif (found) store.sessions[sid] = found[0];\n\nreturn { json: { ...$json, customerId: store.sessions[sid] || '' } };"
