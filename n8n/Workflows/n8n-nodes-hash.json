        "jsCode": "const r = $input.first().json;\nconst checks = [\n  ['hex',        r.hex,      '2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824'],\n  ['base64',     r.b64,      'LPJNul+wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ='],\n  ['base64url',  r.b64url,   'LPJNul-wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ'],\n  ['uppercase + truncate 12', r.short, '2CF24DBA5FB0'],\n  ['salt prefix', r.saltPre, '2cb9c710242d0e384bb068a76a664a10f3970c7e81d58059378cfd5f5ba12b0f'],\n  ['salt suffix', r.saltSuf, 'f6c9737012d25c41df35f6d5d03d8d84912795326ffd5d429ce73977526c67c6'],\n];\nreturn checks.map(([option, got, want]) => ({\n  json: { option, result: got === want ? 'PASS' : 'FAIL', got, want },\n}));"
