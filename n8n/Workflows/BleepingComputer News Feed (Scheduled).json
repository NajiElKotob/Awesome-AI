      "webhookId": "a38f9d26-2042-444d-899d-965542f1fd56",
      "notesInFlow": true,
      "notes": "GET /digest, on-demand; auth none"
    },
    {
      "parameters": {
        "html": "<html><head><meta charset=\"utf-8\"><title>RSS Digest</title><style>\nbody{font:16px/1.5 system-ui;max-width:720px;margin:40px auto;padding:0 20px;color:#1a1a1a}\nh1{font-size:22px;margin-bottom:4px}\n.sub{font-size:13px;color:#888;margin:0 0 20px;border-bottom:2px solid #eee;padding-bottom:14px}\n.item{padding:14px 0;border-bottom:1px solid #f0f0f0}\n.item a{color:#0b5cad;text-decoration:none;font-weight:600}\n.item a:hover{text-decoration:underline}\ntime{display:block;font-size:13px;color:#777;margin-top:4px}\nfooter{margin-top:32px;padding-top:12px;border-top:1px solid #eee;font-size:12px;color:#999;text-align:center}\n</style></head><body>\n<!-- RSS Digest - built with n8n by Naji El Kotob -->\n<h1>RSS Digest</h1>\n<p class=\"sub\">{{ $now.format('cccc, dd LLLL yyyy · HH:mm') }} · {{ $json.data.length }} items</p>\n{{ $json.data.map(a => `<div class=\"item\"><a href=\"${a.link}\">${a.title}</a><time>${a.pubDate}</time></div>`).join('') }}\n<footer>Generated with n8n · Naji El Kotob</footer>\n</body></html>"
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "id": "722294f4-3687-4ba8-8c42-4b4d8e25911b",
      "name": "HTML",
      "notesInFlow": true,
      "notes": "Owns all markup and CSS; live preview"
    },
    {
      "parameters": {
        "jsCode": "const html = $input.first().json.html;\n\nreturn [{\n  json: {},\n  binary: {\n    data: {\n      data: Buffer.from(html, 'utf8').toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'digest.html',\n      fileExtension: 'html'\n    }\n  }\n}];"
      },
