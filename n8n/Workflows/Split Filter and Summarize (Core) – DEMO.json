        0,
        800
      ],
      "notesInFlow": true,
      "webhookId": "f58d1345-f773-4dae-a3a8-168328a17f0b",
      "notes": "Pause 1 second"
    },
    {
      "parameters": {
        "jsCode": "// Runs once per batch (3 items at a time)\n// Add a price band and a 10% discounted price to each product\nfor (const item of $input.all()) {\n  const price = item.json.price;\n  item.json.priceBand = price >= 500 ? 'Premium' : price >= 100 ? 'Mid' : 'Budget';\n  item.json.discountedPrice = Math.round(price * 0.9 * 100) / 100;\n}\nreturn $input.all();"
      },
      "id": "5d6be422-93f5-42c0-8b2d-850c271acff5",
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        800
      ],
      "notesInFlow": true,
      "notes": "Add price band + discount"
    },
    {
      "parameters": {
        "fieldsToSummarize": {
          "values": [
