              "field": "products.title"
            },
            {
              "aggregation": "sum",
              "field": "products.total"
            }
          ]
        },
        "fieldsToSplitBy": "priceBand",
        "options": {}
      },
      "id": "8cfd297e-3b16-4af1-bc9a-c5f8545654c9",
      "name": "Summarize",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1,
